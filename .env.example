# wayfinder 환경변수 예시 — 실제 값은 .env(.local)에 두고 절대 커밋하지 않는다.
# 미설정 시 앱은 데모 모드(mock provider)로 동작한다 (키 0개 빌드/테스트 통과).

# 프록시 base URL (앱 → Cloudflare Workers). 미설정 = 데모 모드.
EXPO_PUBLIC_PROXY_BASE_URL=

# 카카오 지도 키 (스트림 B 웹/네이티브 지도). 미설정 = placeholder 렌더.
EXPO_PUBLIC_KAKAO_JS_KEY=
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=

# ── 프록시 시크릿 (앱이 아니라 wrangler secret으로 주입. 여기는 로컬 dev 참고용) ──
# wrangler secret put KAKAO_REST_KEY
# wrangler secret put GOOGLE_PLACES_KEY
# wrangler secret put NAVER_CLIENT_ID
# wrangler secret put NAVER_CLIENT_SECRET
